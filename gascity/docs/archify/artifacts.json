    { "label": "Generate / refine" },
    { "label": "Publish revisions" },
    { "label": "Ship / memory" }
  ],
  "nodes": [
    { "id": "human-pm-architect", "type": "frontend", "label": "Human + PM / architect", "sublabel": "conversation", "stage": 0, "row": 1, "yOffset": -35, "width": 150, "tag": "proposed" },
    { "id": "approved-json-ir", "type": "database", "label": "Approved IR baseline", "sublabel": "immutable revision / hash", "stage": 1, "row": 1, "yOffset": -35, "width": 160 },
    { "id": "html-review", "type": "frontend", "label": "Human change review", "sublabel": "baseline vs candidate renders", "stage": 1, "row": 2, "yOffset": -45, "width": 160 },
    { "id": "candidate-json-ir", "type": "external", "label": "Candidate JSON IR", "sublabel": "proposal, never an override", "stage": 2, "row": 2, "yOffset": -45, "width": 160 },
    { "id": "discussion-summary", "type": "backend", "label": "Discussion summary", "sublabel": "supplementary Markdown", "stage": 2, "row": 0, "yOffset": -20, "width": 160 },
    { "id": "formula-design-docs", "type": "backend", "label": "Shared refinement", "sublabel": "PRD / HLD / ADR / Specs", "stage": 2, "row": 1, "yOffset": -35, "width": 160, "tag": "initial set + later edits" },
    { "id": "canonical-markdown", "type": "database", "label": "Canonical remote ref", "sublabel": "published Markdown revisions", "stage": 3, "row": 1, "yOffset": -35, "width": 160, "tag": "exact doc authority" },
    { "id": "built-vs-spec-report", "type": "backend", "label": "Build + final report", "sublabel": "pinned specs + built evidence", "stage": 3, "row": 2, "yOffset": -45, "width": 160, "tag": "evidence + why" },
    { "id": "existing-hindsight-ship", "type": "backend", "label": "hindsight ship", "sublabel": "existing Markdown pipeline", "stage": 4, "row": 1, "yOffset": -35, "width": 160 },
