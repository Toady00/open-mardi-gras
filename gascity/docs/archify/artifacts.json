  ],
  "flows": [
    { "id": "author-ir", "from": "human-pm-architect", "to": "approved-json-ir", "label": "author + approve revision", "variant": "emphasis", "route": "straight", "labelAt": [202, 187] },
    { "id": "author-summary", "from": "human-pm-architect", "to": "discussion-summary", "label": "author alongside visuals", "fromSide": "top", "toSide": "left", "via": [[100, 137]], "labelAt": [280, 137] },
    { "id": "accept-new-baseline", "from": "html-review", "to": "approved-json-ir", "label": "approve new baseline", "variant": "emphasis" },
    { "id": "read-approved-ir", "from": "approved-json-ir", "to": "formula-design-docs", "label": "read approved IR directly", "variant": "emphasis", "route": "straight", "labelAt": [422, 278] },
    { "id": "supplement-direction", "from": "discussion-summary", "to": "formula-design-docs", "label": "fill gaps only", "fromSide": "bottom", "toSide": "top", "labelAt": [530, 187] },
    { "id": "publish-summary", "from": "discussion-summary", "to": "canonical-markdown", "label": "publish summary", "fromSide": "right", "toSide": "top", "via": [[745, 137]], "labelAt": [745, 187] },
    { "id": "publish-design-docs", "from": "formula-design-docs", "to": "canonical-markdown", "label": "publish revisions", "variant": "emphasis", "route": "straight", "labelAt": [637, 187] },
    { "id": "suggest-ir-changes", "from": "formula-design-docs", "to": "candidate-json-ir", "label": "suggest IR changes", "variant": "emphasis", "labelAt": [530, 298] },
    { "id": "review-candidate", "from": "candidate-json-ir", "to": "html-review", "label": "visual change review", "variant": "emphasis", "labelAt": [423, 392] },
    { "id": "publish-report", "from": "built-vs-spec-report", "to": "canonical-markdown", "label": "publish report later" },
    { "id": "ship-canonical-docs", "from": "canonical-markdown", "to": "existing-hindsight-ship", "label": "draft + accepted revisions", "variant": "emphasis", "route": "straight", "labelAt": [852, 278] },
    { "id": "retain-markdown", "from": "existing-hindsight-ship", "to": "hindsight-memory", "label": "replace same ID", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "labelAt": [960, 298] }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Generate once, refine every set",
      "items": [
        "Generate once, then ALWAYS refine, no supplied change needed. Later edits enter the same stage: assess whole set, justify corrections/candidate, revise, distinct PM + architect cross-review.",
        "One writer; both lenses across set. Live edits stay draft until review passes. Ready exact revision or human decision. Original IR immutable; candidate approval reconciles docs, not build approval."
      ]
    },
    {
      "dot": "emerald",
      "title": "Cost and review limits",
      "items": [
        "Useful, sufficiently reliable software: credible omission cost vs. complexity, delay, maintenance, including workflow. Hypotheticals alone cannot block; only justified required findings do.",
        "Required / optional / deferred with observable trigger / rejected. Requirements bind unless human changes scope. Deferrals ship as docs/ADRs; triggers mean reassess, not autoimplement."
      ]
    },
    {
      "dot": "violet",
      "title": "Publish prose, keep visuals out",
      "items": [
        "Drafts ship throughout refinement; approval independent of ingestion. Later conversational approvals publish accepted, same IDs. Human explicitly requests builds separately. Reports: built vs. spec + why, even partial/blocked.",
        "Pinned compare: architecture ONLY. These types use before/after renders + change summary. JSON/HTML and all diff evidence stay outside Hindsight. IR = direction; Git = docs; memory = context."
      ]
    }
  ]
}
