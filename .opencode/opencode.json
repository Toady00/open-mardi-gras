{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": ["amazon-bedrock", "synthetic"],
  "permission": {
    "external_directory": {
      "~/code/clones/opencode/**": "allow",
      "/Users/brandondennis/code/clones/opencode/**": "allow",
      "~/code/personal/open-mardi-gras/master/**": "allow",
      "/Users/brandondennis/clones/gascity/**": "allow",
      "~/clones/gascity/**": "allow",
      "/Users/brandondennis/clones/gascity-packs/**": "allow",
      "~/clones/gascity-packs/**": "allow",
    }
  },
  "agent": {
    "build":                         {"model": "{env:OPENCODE_BUILD_MODEL}"},
    "plan":                          {"model": "{env:OPENCODE_PLAN_MODEL}"},
    "oc-smith":                      {"model": "{env:OPENCODE_OC_SMITH_MODEL}"},
    "omg-architect":                 {"model": "{env:OPENCODE_OMG_ARCHITECT_MODEL}"},
    "omg-builder":                   {"model": "{env:OPENCODE_OMG_BUILDER_MODEL}"},
    "omg-build-planner":             {"model": "{env:OPENCODE_OMG_BUILD_PLANNER_MODEL}"},
    "omg-decomposer":                {"model": "{env:OPENCODE_OMG_DECOMPOSER_MODEL}"},
    "omg-foreman":                   {"model": "{env:OPENCODE_OMG_FOREMAN_MODEL}"},
    "omg-implementation-writer":     {"model": "{env:OPENCODE_OMG_IMPLEMENTATION_WRITER_MODEL}"},
    "omg-product-manager":           {"model": "{env:OPENCODE_OMG_PRODUCT_MANAGER_MODEL}"},
    "omg-reviewer":                  {"model": "{env:OPENCODE_OMG_REVIEWER_MODEL}"},
    "omg-technical-program-manager": {"model": "{env:OPENCODE_OMG_TECHNICAL_PROGRAM_MANAGER_MODEL}"},
    "omg-test-planner":              {"model": "{env:OPENCODE_OMG_TEST_PLANNER_MODEL}"},
    "fable":                         {"model": "anthropic/claude-fable-5-1"},
    "grok":                          {"model": "xai/grok-4.6"}
  }
}
